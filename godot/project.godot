; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KAYOS: NoS demo 1"
config/description="A narrative-first 2D top-down RPG. Elorin builds the Nullstone; Grakkar activates it 300 years later. The Legacy System writes Part One choices into Part Two."
run/main_scene="res://threed/coldopen/ColdOpen2.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/GameState.gd"
DialogueManager="*res://autoload/DialogueManager.gd"
SceneManager="*res://autoload/SceneManager.gd"
AudioManager="*res://autoload/AudioManager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false
window/handheld/orientation=4

[gui]

theme/custom="res://ui/default_theme.tres"

